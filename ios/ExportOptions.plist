<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Codemagic workflow الحالي (ios-ipa-unsigned) لا يستخدم xcodebuild -exportArchive -->
	<!-- لأن التصدير يتطلب توقيعاً. الـ IPA يُنشأ من zip لـ Payload/Runner.app بعد flutter build ios --no-codesign -->
	<key>CodemagicUnsignedWorkflow</key>
	<true/>
	<key>Description</key>
	<string>Reserved for future signed builds (flutter build ipa --export-options-plist). Not used for unsigned CI.</string>
	<!-- مثال لتوزيع موقّع لاحقاً — لا تُنفَّذ في البناء غير الموقّع -->
	<key>method</key>
	<string>app-store</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>uploadBitcode</key>
	<false/>
	<key>compileBitcode</key>
	<false/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
